PORT=3000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shift_booking
DB_USER=postgres
DB_PASSWORD=your_password_here

# Azure Document Intelligence (required for OCR extraction)
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your_azure_document_intelligence_key

# Veriff (required for liveness session creation)
VERIFF_API_KEY=
VERIFF_SECRET_KEY=
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFF_CALLBACK_URL=http://localhost:3000/api/liveness/callback
