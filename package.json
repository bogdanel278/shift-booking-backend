{
  "name": "shift-booking-backend",
  "version": "1.0.0",
  "description": "Scalable backend for shift-booking marketplace",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "nodemon --watch src --exec ts-node src/index.ts",
    "db:migrate": "node scripts/migrate.js",
    "db:test": "node -e \"require('dotenv').config(); const {Pool} = require('pg'); const pool = new Pool({host: process.env.DB_HOST, port: process.env.DB_PORT, database: process.env.DB_NAME, user: process.env.DB_USER, password: process.env.DB_PASSWORD, ssl: {rejectUnauthorized: false}}); pool.query('SELECT NOW()').then(r => {console.log('✓ Connected:', r.rows[0].now); pool.end();}).catch(e => {console.error('✗ Failed:', e.message); process.exit(1);});\"",
    "test:rtw": "ts-node scripts/testRightToWork.ts",
    "test:sandbox": "bash scripts/testSandboxQuick.sh",
    "test:onboarding": "ts-node scripts/testWorkerOnboarding.ts"
  },
  "keywords": [
    "shift-booking",
    "marketplace",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.7",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
